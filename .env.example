# --- Modo ---
# offline = SQLite + TF-IDF + modelos stub (no requiere GCP). cloud = servicios reales.
AGENTS_MODE=offline

# --- GCP ---
GOOGLE_CLOUD_PROJECT=tu-proyecto
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=TRUE   # antes GOOGLE_GENAI_USE_VERTEXAI (equivalentes)
# Alternativa rápida: GOOGLE_API_KEY=... (Gemini API) y quitar la línea de arriba
MODEL_NAME=gemini-2.5-flash   # probado en Agent Platform (global y us-central1). Con clave de AI Studio puedes usar el alias gemini-flash-latest
EMBEDDING_MODEL=text-embedding-005

# --- Reranking (Vertex AI Ranking API / Discovery Engine) ---
RANKING_CONFIG=projects/tu-proyecto/locations/global/rankingConfigs/default_ranking_config
RANKING_MODEL=semantic-ranker-default@latest

# --- Agente Auditor (Módulo 2) ---
# AUDITOR_FUENTE: politicas (markdown, un chunk por artículo) | rag_engine (PDFs en RAG Engine; requiere AGENTS_MODE=cloud)
AUDITOR_FUENTE=politicas
# Con rag_engine: los imprime `python modulo2_rag_reranking/preparar_corpus.py`
# RAG_CORPUS_POLITICAS=projects/.../locations/us-central1/ragCorpora/...
# RAG_CORPUS_REPORTES=projects/.../locations/us-central1/ragCorpora/...   (opcional: busca en las dos fuentes con cuota)
# Umbral de relevancia del auditor (por defecto 0.14 en cloud; en offline se calibra solo; se recalibra al cambiar de corpus o de reranker)
# UMBRAL_AUDITOR=0.14


# --- SQL Server (solo cloud / on-prem) ---
MSSQL_URL=mssql+pyodbc://usuario:clave@servidor/finanzas?driver=ODBC+Driver+18+for+SQL+Server
# --- BigQuery ---
BQ_DATASET=finanzas

# --- Servicio ML interno (Modulo 4) ---
ML_SERVICE_URL=http://localhost:8080

# --- Tableau ---
TABLEAU_SERVER_URL=https://tableau.ejemplo.com
TABLEAU_SITE=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_VALUE=
